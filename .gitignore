# Ignore everything except client folder
*
!.gitignore
!client/
!client/**

# But ignore node_modules in client
client/node_modules/

# Ignore environment files with sensitive data
client/.env

# Ignore build artifacts
client/build/
client/dist/

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
